<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="বেতন হিসাব"
                    android:textColor="@color/text"
                    android:textSize="27sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="সেপ্টেম্বর ২০২৬"
                    android:textColor="@color/green"
                    android:textSize="15sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="মাসিক বেতন ও হাজিরার সহজ হিসাব"
                android:textColor="@color/muted"
                android:textSize="14sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="মাসিক বেতন"
                    android:textColor="@color/muted"
                    android:textSize="14sp"/>
                <EditText
                    android:id="@+id/etSalary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input"
                    android:hint="যেমন ৩০,০০০"
                    android:inputType="numberDecimal"
                    android:textSize="20sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="মাসের মোট কর্মদিবস"
                    android:textColor="@color/muted"
                    android:textSize="14sp"/>
                <EditText
                    android:id="@+id/etDays"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input"
                    android:hint="৩০"
                    android:inputType="number"
                    android:text="30"/>

                <Button
                    android:id="@+id/btnCalculate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_button"
                    android:text="বেতন হিসাব করুন"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:background="@drawable/bg_green">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="প্রত্যাশিত বেতন"
                    android:textColor="@color/white"
                    android:textSize="15sp"/>
                <TextView
                    android:id="@+id/tvExpected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="৳ ০"
                    android:textColor="@color/white"
                    android:textSize="38sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvDaily"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="প্রতি দিনের মজুরি: ৳ ০"
                    android:textColor="#D7FFF2"
                    android:textSize="14sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="হাজিরা"
                    android:textColor="@color/text"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvAttendance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="উপস্থিত: ০ দিন   •   অনুপস্থিত: ০ দিন"
                    android:textColor="@color/muted"
                    android:textSize="15sp"/>

                <Button
                    android:id="@+id/btnPresent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button"
                    android:text="আজকের হাজিরা — উপস্থিত"
                    android:textAllCaps="false"
                    android:textColor="@color/white"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ওভারটাইম (OT)"
                    android:textColor="@color/text"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
                <EditText
                    android:id="@+id/etOtHours"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input"
                    android:hint="OT ঘণ্টা, যেমন ১২"
                    android:inputType="numberDecimal"/>
                <EditText
                    android:id="@+id/etOtRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="প্রতি ঘণ্টা OT টাকা"
                    android:inputType="numberDecimal"/>
                <Button
                    android:id="@+id/btnOtCalculate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_button"
                    android:text="OT হিসাব করুন"
                    android:textAllCaps="false"
                    android:textColor="@color/white"/>
                <TextView
                    android:id="@+id/tvOtResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="মোট OT: ৳ ০"
                    android:textColor="@color/green"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ক্যালকুলেটর"
                    android:textColor="@color/text"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
                <EditText
                    android:id="@+id/etCalc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input"
                    android:hint="যেমন 15000 / 26"
                    android:inputType="text"
                    android:textSize="18sp"/>
                <Button
                    android:id="@+id/btnCalc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_button"
                    android:text="হিসাব করুন"
                    android:textAllCaps="false"
                    android:textColor="@color/white"/>
                <TextView
                    android:id="@+id/tvCalcResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="ফলাফল এখানে দেখাবে"
                    android:textColor="@color/green"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="কাস্টম রিমাইন্ডার"
                    android:textColor="@color/text"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
                <EditText
                    android:id="@+id/etReminderText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input"
                    android:hint="রিমাইন্ডার, যেমন হাজিরা দিতে ভুলবেন না"/>
                <Button
                    android:id="@+id/btnReminderTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button"
                    android:text="সময় নির্বাচন করুন"
                    android:textAllCaps="false"
                    android:textColor="@color/white"/>
                <Button
                    android:id="@+id/btnSetReminder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button"
                    android:text="প্রতিদিন রিমাইন্ডার চালু করুন"
                    android:textAllCaps="false"
                    android:textColor="@color/white"/>
                <Button
                    android:id="@+id/btnCancelReminder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="রিমাইন্ডার বন্ধ করুন"
                    android:textAllCaps="false"/>
                <TextView
                    android:id="@+id/tvReminderStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="রিমাইন্ডার বন্ধ"
                    android:textColor="@color/muted"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center"
        android:background="@color/white"
        android:text="⌂  হোম     ▣  ক্যালেন্ডার     ▤  সারসংক্ষেপ     ⚙  সেটিংস"
        android:textColor="@color/green"
        android:textSize="13sp"
        android:textStyle="bold"/>
</LinearLayout>
